<?php
get_header();
function get_filesize( $file_path ) {
  $file_fullpath = str_replace( site_url(), ABSPATH, $file_path );
  if ( is_file( $file_fullpath ) ) {
    $file_size = size_format( filesize( $file_fullpath ) );
    return $file_size;
  }
}
